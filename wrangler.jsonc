{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myip",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "myip.kt3i.net",
      "custom_domain": true
    }
  ]
}
